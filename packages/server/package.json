{
  "name": "@gldywn/gatekeeper-mcp-server",
  "version": "0.1.1",
  "type": "module",
  "description": "MCP server for Gatekeeper: proposes SQL to a human in Beekeeper Studio and returns the approved result to the agent.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "beekeeper-studio",
    "sql",
    "database",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "author": "Gldywn (https://github.com/Gldywn)",
  "homepage": "https://github.com/Gldywn/gatekeeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gldywn/gatekeeper.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/Gldywn/gatekeeper/issues",
  "bin": {
    "gatekeeper-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "notifier.noindex"
  ],
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "notifier.noindex/Gatekeeper.app/Contents/MacOS/gatekeeper-notify"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node notifier/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.11.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@gatekeeper/shared": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
