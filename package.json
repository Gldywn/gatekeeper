{
  "name": "gatekeeper",
  "private": true,
  "version": "0.0.1",
  "description": "Human-approved, LLM-agnostic bridge for running read-only SQL through Beekeeper Studio's connection.",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ci": "pnpm typecheck && pnpm build && pnpm test",
    "dev": "pnpm db:up && pnpm --filter @gatekeeper/plugin dev",
    "db:up": "docker compose -f test-db/compose.yaml up -d --wait",
    "db:down": "docker compose -f test-db/compose.yaml down",
    "dev:link": "node scripts/dev.mjs link",
    "dev:unlink": "node scripts/dev.mjs unlink",
    "dev:status": "node scripts/dev.mjs status",
    "dev:reset": "node scripts/dev.mjs reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
