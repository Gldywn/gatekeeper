---
import ApprovalCard from "./how/ApprovalCard.astro";
import AuditTrail from "./how/AuditTrail.astro";
import AutoMode from "./how/AutoMode.astro";
---
<section class="w section" id="how">
  <div class="section-head c">
    <span class="eyebrow">How it works</span>
    <h2 class="headline">Every query stops at a card that says <em>what it will do.</em></h2>
    <p class="lede">Gatekeeper reads the SQL before you do and nothing runs until you or Auto mode approve it.</p>
  </div>
  <ApprovalCard />
  <AutoMode />
  <AuditTrail />
</section>

<style>
  .section-head.c .headline { max-width: 19ch; }
</style>
