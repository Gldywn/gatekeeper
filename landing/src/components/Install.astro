---
import { beekeeperMark } from "./agents";

const repo = "https://github.com/Gldywn/gatekeeper";
const cmd = "npx skills add Gldywn/gatekeeper";
---
<section class="w section" id="install">
  <div class="panel">
    <div class="pitch">
      <img src="/gatekeeper-icon.svg" alt="" width="56" height="56" />
      <h2 class="headline">Install Gatekeeper <em>in a minute.</em></h2>
      <p class="lede">Free and open source under the <a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT license</a>.<br />Issues and pull requests are welcome.</p>
      <div class="links">
        <a class="btn amber" href={repo} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.77 4.65 1.12 6.57L12 17.4l-5.9 3.16 1.12-6.57L2.45 9.34l6.6-.96z"/></svg>Star on GitHub</a>
        <a class="btn ghost" href={`${repo}#getting-started`} target="_blank" rel="noopener">See the prerequisites</a>
      </div>
    </div>
    <ol class="steps">
      <li>
        <span class="n" aria-hidden="true">1</span>
        <div class="b">
          <h3>Add the plugin <span class="where">in <a class="bks" href="https://www.beekeeperstudio.io/" target="_blank" rel="noopener">Beekeeper Studio<span class="bks-mark" set:html={beekeeperMark} /></a></span></h3>
          <ul class="menu-path"><li>Tools</li><li>Manage Plugins</li><li>Gatekeeper</li><li>Install</li></ul>
          <p>Not listed? Turn on Community Plugins in the same window.</p>
        </div>
      </li>
      <li>
        <span class="n" aria-hidden="true">2</span>
        <div class="b">
          <h3>Set up your agent <span>in a terminal</span></h3>
          <pre class="cmd"><button class="cmd-copy" type="button" data-copy={cmd} aria-label="Copy the command"><svg class="cp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></button><span class="p">$ </span>{cmd}
<span class="p">&gt; </span>/install-gatekeeper  <span class="c"># in your agent</span></pre>
          <p>The skill registers the MCP server and walks you through pairing.</p>
        </div>
      </li>
    </ol>
    <p class="req">Requires Beekeeper Studio 5.4 or later.</p>
  </div>
</section>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    b.addEventListener("click", () => {
      navigator.clipboard
        .writeText(b.dataset.copy ?? "")
        .then(() => {
          b.dataset.done = "";
          setTimeout(() => delete b.dataset.done, 1600);
        })
        .catch(() => {});
    });
  }
</script>

<style>
  .panel { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 28px clamp(32px, 6vw, 88px); padding: clamp(28px, 5vw, 64px); border-radius: 28px; background: radial-gradient(80% 110% at 0% 0%, color-mix(in oklch, var(--amber) 13%, transparent), transparent 62%), var(--g-card); box-shadow: inset 0 0 0 1px var(--g-line); }
  .pitch { display: grid; gap: 18px; align-content: center; justify-items: start; }
  .pitch img { width: 56px; height: 56px; filter: drop-shadow(0 12px 28px oklch(0% 0 0 / 0.5)); }
  .pitch .headline { font-size: clamp(2rem, 3.6vw, 3rem); max-width: 12ch; }
  .pitch .lede { font-size: 16.5px; max-width: 36ch; }
  .pitch .lede a { color: var(--text); text-decoration: underline; text-decoration-color: color-mix(in oklch, currentColor 40%, transparent); text-underline-offset: 3px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; align-content: center; }
  .steps > li { display: grid; grid-template-columns: 56px minmax(0, 1fr); padding-block: 26px; }
  .steps > li + li { border-top: 1px solid var(--g-line); }
  .n { font: 400 44px / 1 var(--g-mono); letter-spacing: -0.04em; color: var(--amber); }
  .b { display: grid; gap: 14px; min-width: 0; }
  h3 { margin: 0; font-size: 19px; font-weight: 600; letter-spacing: -0.02em; }
  h3 span { font-weight: 400; color: var(--faint); }
  h3 .where { white-space: nowrap; }
  /* Beekeeper Yellow, from Beekeeper Studio's press kit, for their name and mark. */
  .bks { color: #fad83b; text-decoration: underline; text-decoration-color: color-mix(in oklch, currentColor 35%, transparent); text-underline-offset: 4px; }
  .bks:hover { text-decoration-color: currentColor; }
  .bks-mark { display: inline-block; width: 1.05em; height: 1.05em; margin-left: 0.3em; vertical-align: -0.17em; }
  .bks-mark :global(svg) { display: block; width: 100%; height: 100%; }
  .b p { font-size: 14.5px; color: var(--muted); }
  .req { grid-column: 1 / -1; padding-top: 20px; border-top: 1px solid var(--g-line); font-size: 13.5px; color: var(--faint); }
  @media (max-width: 900px) {
    .panel { grid-template-columns: minmax(0, 1fr); border-radius: 20px; }
    .steps > li { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .n { font-size: 32px; }
  }
</style>
