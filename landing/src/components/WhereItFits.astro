const rowCss = `.pane{width:100%}.ix-row svg{width:13px;height:13px}`;
// Each situation holds 5 s and fades out before the next one fades in. Reduced motion keeps the
// first of each slot, still, under the fade.
const moreCss = `${rowCss}
.slot{display:grid}
.it{grid-area:1/1;display:grid;grid-template-rows:auto 1fr auto;gap:12px;opacity:0;animation:cyc 20s var(--ease-in-out) infinite;animation-delay:calc(var(--i) * 5s - var(--o))}
.kind{font:500 11.5px/1 var(--g-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--amber)}
.t{margin:0 0 8px;font:600 clamp(1.15rem,1.7vw,1.4rem)/1.18 var(--g-sans);letter-spacing:-.03em;color:var(--text);text-wrap:balance}
@keyframes cyc{0%{opacity:0;translate:0 10px}4%{opacity:1;translate:0 0}20%{opacity:1;translate:0 0}24%{opacity:0;translate:0 -10px}100%{opacity:0}}
@media (prefers-reduced-motion:reduce){.it{animation:none}.it:first-child{opacity:1}}`;
---
<section class="w section" id="fit">
  <div class="section-head">
    <span class="eyebrow">Where it fits</span>
    <h2 class="headline"><em>For anyone</em> nervous about an agent near the live database.</h2>
  </div>
  <div class="cases">
    {cases.map((c) => (
      <article>
        <span class="kind">{c.kind}</span>
        <h3>{c.t}</h3>
        <PluginView>
          <style is:inline set:html={rowCss}></style>
          <div class="pane"><QueueRow {...c.row} /></div>
        </PluginView>
      </article>
    ))}
  </div>
  <div class="more" aria-hidden="true">
    {more.map((slot, s) => (
      <div class="cell" style={`--o:${s * 1.7}s`}>
        <PluginView>
          <style is:inline set:html={moreCss}></style>
          <div class="slot">
            {slot.map((c, i) => (
              <div class="it" style={`--i:${i}`}>
                <span class="kind">{c.kind}</span>
                <span class="t">{c.t}</span>
                <div class="pane"><QueueRow {...c.row} /></div>
              </div>
            ))}
          </div>
        </PluginView>
      </div>
    ))}
  </div>
</section>

<style>
  .headline { max-width: 22ch; }
  .cases, .more { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cases { border-top: 1px solid var(--g-line); }
  article, .cell { padding: 28px 28px 30px; }
  article { display: grid; grid-template-rows: auto 1fr auto; gap: 12px; border-bottom: 1px solid var(--g-line); }
  :is(article, .cell):nth-child(3n + 1) { padding-left: 0; }
  :is(article, .cell):nth-child(3n) { padding-right: 0; }
  :is(article, .cell):not(:nth-child(3n + 1)) { border-left: 1px solid var(--g-line); }
  /* The list carries on below the six and fades out, column lines included. */
  .more { mask-image: linear-gradient(180deg, #000 35%, transparent 92%); }
  .kind { font: 500 11.5px / 1 var(--g-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber); }
  h3 { margin: 0 0 8px; font-size: clamp(1.15rem, 1.7vw, 1.4rem); line-height: 1.18; font-weight: 600; letter-spacing: -0.03em; text-wrap: balance; }
  @media (max-width: 1000px) {
    .cases, .more { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    article, .cell, :is(article, .cell):nth-child(n) { padding: 26px 24px 28px; border-left: 0; }
    :is(article, .cell):nth-child(odd) { padding-left: 0; }
    :is(article, .cell):nth-child(even) { padding-right: 0; border-left: 1px solid var(--g-line); }
    .cell:nth-child(3) { display: none; }
  }
  @media (max-width: 640px) {
    .cases, .more { grid-template-columns: minmax(0, 1fr); }
    article, .cell, :is(article, .cell):nth-child(n) { padding: 22px 0 24px; border-left: 0; }
    .cell:nth-child(n + 2) { display: none; }
  }
</style>
