---
// Six everyday situations, each with the query it comes down to as the plugin's own Queue row.
// Below them, more situations keep fading in and out, so the list reads as one that never ends.
import QueueRow from "./how/QueueRow.astro";
import PluginView from "./plugin/PluginView.astro";

type Row = Parameters<typeof QueueRow>[0];
type Case = { kind: string; t: string; row: Row };

