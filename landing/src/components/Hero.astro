---
import PluginView from "./plugin/PluginView.astro";

// The background is the plugin's own Queue rows (inbox.ts markup, its stylesheet in a shadow
// root): pending proposals with their clock, decided ones with their glyph and one fact. The
// write waiting for approval stays lit because writes always wait for a human.
type Agent = "cc" | "cx" | "oc";
type Card = {
  title: string;
  agent: Agent;
  who: string;
  // Side of the copy, distance of the card's inner edge from the centre, and top (px).
  side: "l" | "r";
  e: number;
  y: number;
  depth?: "far" | "deep" | "lit";
  write?: boolean;
} & (
  | { kind: "pend"; left: string; low?: boolean; evaluating?: boolean }
  | {
      kind: "done";
      age: string;
      fact: string;
      glyph: "auto" | "approved" | "rejected";
      flag?: "pii" | "client";
    }
);

// Each side is an arc round the copy: the rows above the pill and below the buttons sit close to
// the centre, the middle rows further out. Beside the headline and lead, never under 395px.
const cards: Card[] = [
  {
    kind: "done",
    glyph: "auto",
    title: "Orders per day this week",
    agent: "cx",
    who: "analytics",
    age: "0s ago",
    fact: "7 rows",
    depth: "far",
    side: "l",
    e: 270,
    y: 10,
  },
  {
    kind: "done",
    glyph: "approved",
    flag: "pii",
    title: "Churned customer emails",
    agent: "cc",
    who: "crm",
    age: "2m ago",
    fact: "38 rows",
    depth: "far",
    side: "l",
    e: 430,
    y: 112,
  },
  {
    kind: "pend",
    title: "Customer emails on open tickets",
    agent: "cx",
    who: "support-desk",
    left: "4:41",
    side: "l",
    e: 480,
    y: 218,
  },
  {
    kind: "done",
    glyph: "auto",
    title: "Signups by referral source",
    agent: "oc",
    who: "growth",
    age: "40s ago",
    fact: "9 rows",
    depth: "deep",
    side: "l",
    e: 490,
    y: 324,
  },
  {
    kind: "done",
    glyph: "approved",
    write: true,
    title: "Close resolved tickets",
    agent: "cx",
    who: "support-desk",
    age: "1m ago",
    fact: "9 affected",
    depth: "far",
    side: "l",
    e: 440,
    y: 430,
  },
  {
    kind: "pend",
    evaluating: true,
    title: "Search latency by day",
    agent: "oc",
    who: "search",
    left: "4:58",
    side: "l",
    e: 240,
    y: 528,
  },
  {
    kind: "done",
    glyph: "auto",
    title: "Revenue per plan in Q3",
    agent: "cc",
    who: "finance",
    age: "20s ago",
    fact: "4 rows",
    depth: "far",
    side: "r",
    e: 255,
    y: 10,
  },
  {
    kind: "pend",
    write: true,
    low: true,
    title: "Extend two trials by a week",
    agent: "cc",
    who: "billing-api",
    left: "0:38",
    side: "r",
    e: 445,
    y: 112,
  },
  {
    kind: "done",
    glyph: "approved",
    flag: "client",
    title: "Overdue by company",
    agent: "oc",
    who: "billing-api",
    age: "5m ago",
    fact: "12 rows",
    depth: "far",
    side: "r",
    e: 470,
    y: 218,
  },
  {
    kind: "done",
    glyph: "rejected",
    title: "Drop the old sessions table",
    agent: "cx",
    who: "platform",
    age: "3m ago",
    fact: "Declined",
    depth: "deep",
    side: "r",
    e: 500,
    y: 324,
  },
  {
    kind: "done",
    glyph: "auto",
    title: "Refunds issued since Monday",
    agent: "cx",
    who: "payments",
    age: "1m ago",
    fact: "31 rows",
    depth: "far",
    side: "r",
    e: 430,
    y: 430,
  },
  {
    kind: "pend",
    write: true,
    depth: "lit",
    title: "Void two duplicate invoices",
    agent: "cc",
    who: "billing-api",
    left: "4:12",
    side: "r",
    e: 225,
    y: 528,
  },
];

const GLYPH = { auto: "#bolt", approved: "#check", rejected: "#xc" };

// 312px is a card (288px) plus the room its float and a scrollbar need at the screen edge, so a
// narrow screen pulls the arc in. Each card floats on its own path, never in lockstep.
const place = (c: Card, i: number) => {
  const inner = `min(${c.e}px, 50% - 312px)`;
  const left = c.side === "l" ? `calc(50% - ${inner} - 288px)` : `calc(50% + ${inner})`;
  return (
    `left:${left};top:${c.y}px;--dx:${10 + ((i * 5) % 6)}px;--dy:${6 + ((i * 3) % 5)}px;` +
    `--tx:${9 + ((i * 7) % 5)}s;--ty:${6 + ((i * 3) % 4)}s;--px:-${((i * 13) % 90) / 10}s;--py:-${((i * 9) % 60) / 10}s`
  );
};

// The page's reduced-motion rule cannot cross the shadow boundary, so the root carries its own.
// The fade is a transition because the no-JS and Pause rules hold every animation.
const float = `:host{position:absolute;inset:0}
.fc{position:absolute;width:288px;opacity:.55;transition:opacity .9s .2s var(--ease);animation:fx var(--tx) var(--ease-in-out) var(--px) infinite alternate,fy var(--ty) var(--ease-in-out) var(--py) infinite alternate}
.fc svg{width:13px;height:13px}
.fc.far{opacity:.4;scale:.92}
.fc.deep{opacity:.28;scale:.85}
.fc.lit{opacity:.95}
.fc.mid{display:none}
@media (min-width:1440px){.fc.mid{display:flex}}
@starting-style{.fc,.fc.far,.fc.deep,.fc.lit{opacity:0}}
@keyframes fx{from{translate:calc(var(--dx) * -1) 0}to{translate:var(--dx) 0}}
@keyframes fy{from{transform:translateY(calc(var(--dy) * -1))}to{transform:translateY(var(--dy))}}
@media (prefers-reduced-motion:reduce){.fc{animation:none;transition:none}}`;
---
<section class="hero" id="top">
  <div class="float" aria-hidden="true">
    <PluginView>
      <style is:inline set:html={float}></style>
      {cards.map((c, i) => (
        <div class:list={["pane", "fc", c.depth, { mid: c.e > 320 }]} style={place(c, i)}>
          {c.kind === "pend" ? (
            <div class="ix-row pend">
              <span class="ix-mark"><span class:list={["ix-dot", { eval: c.evaluating }]}></span></span>
              <span class="ix-main"><span class="ix-title">{c.title}</span><span class="ix-meta"><span class="harness-badge"><svg viewBox="0 0 24 24"><use href={`#${c.agent}`} /></svg></span><span class="ix-who">{c.who}</span></span></span>
              <span class="ix-end">{c.write && <span class="ix-risk write"><svg viewBox="0 0 24 24"><use href="#pen" /></svg></span>}<span class:list={["ix-side", { low: c.low }]}>{c.left}</span></span>
            </div>
          ) : (
            <div class="ix-row done">
              <span class="ix-mark"><span class:list={["hstate", c.glyph]}><svg viewBox="0 0 24 24"><use href={GLYPH[c.glyph]} /></svg></span></span>
              <span class="ix-title">{c.title}</span>
              <span class="ix-top">{c.write && <span class="ix-risk write"><svg viewBox="0 0 24 24"><use href="#pen" /></svg></span>}{c.flag && <span class="act-flags"><span class:list={["act-flag", c.flag]}>{c.flag === "pii" ? "PII" : "Client"}</span></span>}<span class="hage">{c.age}</span></span>
              <span class="ix-meta"><span class="harness-badge"><svg viewBox="0 0 24 24"><use href={`#${c.agent}`} /></svg></span><span class="ix-who">{c.who}</span></span>
              <span class="ix-fact">{c.fact}</span>
            </div>
          )}
        </div>
      ))}
    </PluginView>
  </div>
  <div class="w hero-in">
    <a class="new" href="#auto-mode"><span class="auto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 3-9 11h7l-1 7 10-12h-7z"/></svg>Auto mode</span>Now available<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
    <h1>The <em>database harness</em> for AI agents.</h1>
    <p class="sub">Stop <em>gambling</em> with your production database.</p>
    <p class="lead">Agents propose SQL over MCP and approved queries run on your Beekeeper Studio connection. With Auto mode on, eligible reads run without a click and writes always wait for you. The agent never holds your database credentials.</p>
    <div class="cta">
      <a class="btn amber" href="/install"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>Install Gatekeeper</a>
      <a class="btn ghost" href="https://github.com/Gldywn/gatekeeper" target="_blank" rel="noopener"><svg class="star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>Star on GitHub</a>
    </div>
    <p class="req">Requires Beekeeper Studio 5.4 or later</p>
  </div>
</section>

<style>
  .hero { position: relative; margin-top: clamp(0px, 2.5vw, 40px); padding-block: clamp(64px, 9vw, 96px) clamp(72px, 9vw, 128px); text-align: center; overflow: hidden; }
  .float { position: absolute; inset: 0; pointer-events: none; }

  .hero-in { position: relative; display: grid; justify-items: center; }
  /* The plugin's armed Auto mode chip (style.css .armed-chip.auto), inside a pill whose radius
     follows the chip's. */
  .new { display: inline-flex; gap: 10px; align-items: center; font-size: 13.5px; color: var(--muted); padding: 4px 10px 4px 4px; border-radius: 10px; background: color-mix(in oklch, var(--auto) 7%, transparent); box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--auto) 22%, transparent); transition: background var(--dur) var(--ease), color var(--dur) var(--ease); }
  .new:hover { color: var(--text); background: color-mix(in oklch, var(--auto) 12%, transparent); }
  .new .auto { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px 3px 6px; border-radius: 6px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--auto-ink); background: var(--auto); animation: auto-pulse 2s var(--ease-in-out) infinite; }
  .new .auto svg { width: 13px; height: 13px; }
  .new .chev { width: 13px; height: 13px; margin-left: -4px; color: var(--faint); }
  @keyframes auto-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--auto) 55%, transparent); }
    70%, 100% { box-shadow: 0 0 0 6px color-mix(in oklch, var(--auto) 0%, transparent); }
  }
  h1 { margin: 24px 0 0; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.02; font-weight: 600; letter-spacing: -0.04em; max-width: 15ch; text-wrap: balance; }
  h1 em { font-style: normal; color: var(--amber); }
  @media (min-width: 640px) { h1 em { white-space: nowrap; } }
  .sub { margin-top: 18px; font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.35; font-weight: 500; letter-spacing: -0.015em; color: var(--text); text-wrap: balance; }
  .lead { margin-top: 14px; max-width: 58ch; font-size: 17px; color: var(--muted); }
  .cta { margin-top: 28px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .btn .star { color: var(--amber); }
  .req { margin-top: 14px; font-size: 14px; color: var(--faint); }
  /* Under 1280px the arc would shrink to its four end cards; the copy stands alone there. */
  @media (max-width: 1279px) { .float { display: none; } }
</style>
