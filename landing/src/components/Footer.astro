<style>
  /* "Works with" moves under the brand, set off by a short fading hairline. */
  .fw-sep { width: 92px; height: 1px; background: linear-gradient(90deg, var(--edge-strong), transparent); }
  .foot-works { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 11px; }
