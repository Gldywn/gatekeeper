  .fw-more { font-size: 12.5px; font-style: italic; color: var(--faint); }

  /* A little life on each harness mark, a distinct subtle loop per agent. */
  @media (prefers-reduced-motion: no-preference) {
    .harness-strip .hb { will-change: transform; }
    .harness-strip .hb:nth-child(1) { animation: hb-hop 2.4s var(--ease-in-out) infinite; }
    .harness-strip .hb:nth-child(2) { animation: hb-tilt 2.9s var(--ease-in-out) infinite; }
    .harness-strip .hb:nth-child(3) { animation: hb-zoom 2.6s var(--ease-in-out) infinite; }
  }
  @keyframes hb-hop { 0%, 100% { transform: translateY(0); } 45% { transform: translateY(3px); } 72% { transform: translateY(-1px); } }
  @keyframes hb-tilt { 0%, 100% { transform: rotate(-7deg); } 50% { transform: rotate(7deg); } }
  @keyframes hb-zoom { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.24); } }

  /* Legal line: an info glyph + a brighter, slightly larger, more readable sentence. */
  .foot-legal { display: flex; align-items: center; gap: 9px; margin: clamp(26px, 3.6vw, 40px) 0 0; padding-top: 18px; border-top: 1px solid var(--edge); font-size: 13px; line-height: 1.5; color: color-mix(in oklch, var(--muted) 55%, var(--text)); }
  .foot-legal svg { width: 15px; height: 15px; color: var(--faint); flex: none; }
  .foot-legal strong { font-weight: 600; color: var(--text); }

  /* Honeycomb echo, the hero's top-right deco mirrored 180deg into the bottom-left: the dense
