<style>
  /* Two staggered columns: the interactive gate + audit on the left, always-on
     protections + roster on the right. Each column flows on its own, so the second
     block sits a fixed gap below the first and the two sides offset naturally. */
  .sg-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(22px, 4vw, 44px);
    align-items: start;
  }
  @media (max-width: 900px) { .sg-cols { grid-template-columns: 1fr; } }
  .sg-title { display: flex; align-items: center; gap: 13px; font-size: clamp(1.12rem, 1.5vw, 1.25rem); font-weight: 680; letter-spacing: -0.015em; color: var(--text); margin: 0 0 16px; }
  .sg-title::after { content: ""; flex: 1; height: 1px; background: linear-gradient(90deg, var(--edge-strong), transparent); }
  /* The second sub-section in each column: a consistent gap creates the staggered rhythm. */
  .sg-title2 { margin-top: clamp(30px, 3.6vw, 44px); }

  /* "Say Yes" gets a playful highlighter swipe, on top of the amber-italic accent. */
  .say-yes { position: relative; white-space: nowrap; text-shadow: 0 1px 2px oklch(0% 0 0 / 0.5), 0 4px 16px oklch(0% 0 0 / 0.32); }
  .say-yes::before {
    content: ""; position: absolute; z-index: -1;
    left: -0.1em; right: -0.1em; top: 0.44em; bottom: 0.03em;
    background: color-mix(in oklch, var(--amber) 34%, transparent);
    border-radius: 2px; transform: rotate(-1.5deg);
  }

  /* A prominent description, emphasised with type only (brighter + a touch larger) so it
     reads as a description in the landing's voice, not a boxed callout. */
  .sg-desc {
    margin: 13px 0 16px;
    font-size: 15.5px; line-height: 1.6;
    color: color-mix(in oklch, var(--muted) 12%, var(--text));
    max-width: 62ch;
  }

  .gd-menu { display: flex; flex-wrap: wrap; gap: 8px; }
  .gd-item {
    display: inline-flex; align-items: center; gap: 8px;
    cursor: pointer; font: inherit;
    padding: 7px 12px; border-radius: 10px;
    border: 1px solid var(--edge);
    background: color-mix(in oklch, var(--surface) 55%, transparent);
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .gd-item:hover { border-color: var(--edge-strong); }
  .gd-item.is-active {
    border-color: color-mix(in oklch, var(--amber) 45%, var(--edge));
    background: color-mix(in oklch, var(--amber) 9%, var(--surface));
  }
  .gd-item-ico {
    flex: none; width: 24px; height: 24px; border-radius: 6px;
    display: grid; place-items: center; color: var(--amber);
    background: color-mix(in oklch, currentColor 12%, transparent);
    border: 1px solid color-mix(in oklch, currentColor 24%, transparent);
  }
  .gd-item-ico svg { width: 14px; height: 14px; }
  .gd-item-ico.ok { color: var(--ok); }
  .gd-item-ico.danger { color: var(--danger); }
  .gd-item-ico.blue { color: var(--exec); }
  .gd-item-ico.violet { color: var(--client); }
  .gd-item-title { font-size: 12.5px; font-weight: 560; color: var(--text); }

  .gd-preview { position: relative; min-width: 0; }
  .gd-preview .card[hidden] { display: none; }

  .gd-verdict {
    display: flex; align-items: center; gap: 8px;
    margin-top: var(--s3); padding: 10px 12px; border-radius: 7px;
    font-size: 13px; font-weight: 560;
  }
  .gd-verdict[hidden] { display: none; }
  .gd-verdict.ok { color: var(--ok); background: color-mix(in oklch, var(--ok) 12%, transparent); border: 1px solid color-mix(in oklch, var(--ok) 30%, transparent); }
  .gd-verdict.no { color: var(--muted); background: color-mix(in oklch, var(--text) 6%, transparent); border: 1px solid var(--edge); }
  .gd-verdict.sent { color: var(--exec); background: color-mix(in oklch, var(--exec) 12%, transparent); border: 1px solid color-mix(in oklch, var(--exec) 30%, transparent); }

  .deny-box { margin-top: var(--s3); padding-top: var(--s3); border-top: 1px solid var(--edge); display: flex; flex-direction: column; gap: 8px; }
  .deny-label { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }
  .deny-input {
    font: inherit; font-size: 13px; line-height: 1.5; color: var(--text);
    width: 100%; box-sizing: border-box; resize: vertical;
    background: var(--sunken); border: 1px solid var(--edge-strong); border-radius: 7px; padding: 9px 11px;
  }
  .deny-input:focus { outline: none; border-color: color-mix(in oklch, var(--amber) 55%, var(--edge-strong)); }
  .deny-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }
  .gd-send { font: inherit; font-size: 12.5px; font-weight: 570; padding: 7px 15px; border-radius: 6px; border: none; cursor: pointer; background: var(--amber); color: var(--amber-ink); }
  .gd-send:hover { filter: brightness(1.06); }

  .tiles-2x2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 520px) { .tiles-2x2 { grid-template-columns: 1fr; } }

  /* Audit export affordance. */
  .export-note { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 14px; padding: 10px 13px; font-size: 12.5px; color: var(--muted); background: color-mix(in oklch, var(--surface) 45%, transparent); border: 1px solid var(--edge); border-radius: 9px; }
  .export-note svg { width: 15px; height: 15px; color: var(--faint); flex: none; }
  .export-note .fmt { font-family: var(--font-mono); font-size: 11px; color: var(--text); background: color-mix(in oklch, var(--text) 8%, transparent); border: 1px solid var(--edge); border-radius: 5px; padding: 2px 7px; }

  /* Detailed query view: open a past query and read the rows it returned. */
  .qdetail { margin-top: clamp(30px, 4vw, 48px); }
  .qd-card { border-radius: var(--r); background: var(--surface); border: 1px solid var(--edge); box-shadow: inset 0 1px 0 var(--hi), var(--elev-1); padding: var(--s3); }
  .qd-head { display: flex; align-items: center; gap: 9px; }
  .qd-badge { flex: none; display: inline-grid; place-items: center; width: 22px; height: 22px; color: var(--amber); }
  .qd-badge svg { width: 17px; height: 17px; fill: currentColor; }
  .qd-who { font-weight: 620; font-size: 13.5px; color: var(--text); }
  /* Status stays inline, right after the name (a bare glyph, no box); only the close pushes right. */
  .qd-status { display: inline-flex; align-items: center; }
  .qd-status.ok { color: var(--ok); }
  .qd-status svg { width: 15px; height: 15px; }
  .qd-close { flex: none; display: inline-grid; place-items: center; width: 24px; height: 24px; margin-left: auto; border-radius: 6px; border: none; cursor: pointer; color: var(--faint); background: transparent; transition: color var(--dur) var(--ease), background var(--dur) var(--ease); }
  .qd-close:hover { color: var(--text); background: color-mix(in oklch, var(--text) 6%, transparent); }
  .qd-close svg { width: 15px; height: 15px; }
  .qd-meta { font-family: var(--font-mono); font-size: 11px; color: var(--faint); margin: 7px 0 10px; }
  .qd-intent { font-weight: 600; font-size: 14px; color: var(--text); margin: 0 0 10px; }
  .qd-oc { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ok); margin: 13px 0 9px; }
  .qd-oc svg { width: 15px; height: 15px; flex: none; }
  .qd-oc b { color: var(--text); font-weight: 620; }
  .qd-oc-meta { color: var(--muted); font-weight: 500; }

  /* Result grid: a framed, paginated data grid standing in for the plugin's Tabulator. */
  .qd-grid { border: 1px solid var(--edge); border-radius: 8px; overflow: hidden; }
  .qd-scroll { overflow-x: auto; }
  .qd-grid table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .qd-grid th, .qd-grid td { text-align: left; padding: 7px 13px; white-space: nowrap; border-bottom: 1px solid var(--edge); border-right: 1px solid color-mix(in oklch, var(--edge) 60%, transparent); }
  .qd-grid th:last-child, .qd-grid td:last-child { border-right: none; }
  .qd-grid thead th { font-size: 10.5px; font-weight: 650; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); background: var(--sunken); cursor: pointer; }
  .qd-grid thead th.sortable { position: relative; padding-right: 24px; }
  .qd-grid thead th.sortable::after { content: ""; position: absolute; right: 11px; top: 50%; width: 0; height: 0; margin-top: -2px; border-left: 3.5px solid transparent; border-right: 3.5px solid transparent; border-top: 4px solid var(--faint); opacity: 0.45; }
  .qd-grid tbody td { font-family: var(--font-mono); color: var(--muted); }
  .qd-grid tbody tr:nth-child(even) td { background: color-mix(in oklch, var(--text) 3.5%, transparent); }
  .qd-grid tbody tr:hover td { background: color-mix(in oklch, var(--amber) 9%, transparent); }
  .qd-grid tbody tr:last-child td { border-bottom: none; }
  .qd-grid th.num, .qd-grid td.num { text-align: right; }
  .qd-grid td.num { color: var(--text); font-variant-numeric: tabular-nums; }

  /* Grid pager, seated on the grid's bottom edge like the real one. */
  .qd-pager { display: flex; align-items: center; gap: 4px; padding: 7px 10px; border-top: 1px solid var(--edge); background: var(--sunken); }
  .qp-nav, .qp-pg { display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 6px; font: inherit; font-size: 11.5px; color: var(--muted); background: transparent; border: 1px solid transparent; border-radius: 6px; cursor: pointer; }
  .qp-nav svg { width: 14px; height: 14px; }
  .qp-nav:disabled { color: var(--faint); opacity: 0.5; cursor: default; }
  .qp-pg:hover, .qp-nav:not(:disabled):hover { border-color: var(--edge-strong); color: var(--text); }
  .qp-pg.is-on { background: color-mix(in oklch, var(--amber) 16%, transparent); border-color: color-mix(in oklch, var(--amber) 40%, var(--edge)); color: var(--text); font-weight: 600; }
  .qp-size { margin-left: auto; font-size: 10.5px; font-family: var(--font-mono); color: var(--faint); }

  .qd-foot { display: flex; align-items: center; gap: 12px; margin-top: 11px; flex-wrap: wrap; }
  .qd-rc { font-size: 12.5px; color: var(--muted); }
  .qd-rc b { color: var(--text); }
  .qd-actions { margin-left: auto; display: flex; gap: 8px; }
  .qd-menu { position: relative; }
  .qd-act { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: 12px; font-weight: 550; color: var(--muted); cursor: pointer; padding: 5px 10px; border-radius: 6px; border: 1px solid var(--edge); background: color-mix(in oklch, var(--text) 3%, transparent); transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .qd-act:hover { color: var(--text); border-color: var(--edge-strong); }
  .qd-act svg { width: 14px; height: 14px; }
  .qd-chev { width: 12px; height: 12px; color: var(--faint); transition: transform var(--dur) var(--ease); }
  .qd-act[aria-expanded="true"] .qd-chev { transform: rotate(180deg); }
  .qd-flyout { position: absolute; right: 0; bottom: calc(100% + 6px); z-index: 5; min-width: 152px; display: flex; flex-direction: column; gap: 2px; padding: 5px; border-radius: 9px; border: 1px solid var(--edge-strong); background: var(--surface); box-shadow: var(--elev-2); }
  .qd-flyout[hidden] { display: none; }
  .qd-fly-item { display: flex; align-items: center; gap: 8px; font: inherit; font-size: 12.5px; color: var(--text); cursor: pointer; padding: 7px 9px; border: none; border-radius: 6px; background: transparent; text-align: left; }
  .qd-fly-item svg { width: 14px; height: 14px; color: var(--faint); flex: none; }
  .qd-fly-item:hover { background: color-mix(in oklch, var(--text) 6%, transparent); }
  .qd-ext { margin-left: auto; font-family: var(--font-mono); font-size: 10.5px; color: var(--faint); }
</style>

<script>
  const demo = document.getElementById("gate-demo");
  if (demo) {
    const items = Array.from(demo.querySelectorAll(".gd-item"));
    const cards = Array.from(demo.querySelectorAll(".gd-preview .card"));

    const resetCard = (card) => {
      const verdict = card.querySelector(".gd-verdict");
      const actions = card.querySelector(".actions");
      const box = card.querySelector(".deny-box");
      if (verdict) { verdict.hidden = true; verdict.textContent = ""; verdict.className = "gd-verdict"; }
      if (actions) actions.style.display = "";
      if (box) box.style.display = "";
    };

    const descEl = document.getElementById("gd-desc");
    const show = (ex) => {
      items.forEach((i) => {
        const on = i.dataset.ex === ex;
        i.classList.toggle("is-active", on);
        i.setAttribute("aria-selected", on ? "true" : "false");
        if (on && descEl) descEl.textContent = i.dataset.desc || "";
      });
      cards.forEach((c) => {
        c.hidden = c.dataset.ex !== ex;
        resetCard(c);
      });
    };
    items.forEach((i) => i.addEventListener("click", () => show(i.dataset.ex)));

    const settle = (card, cls, text) => {
      const actions = card.querySelector(".actions");
      const box = card.querySelector(".deny-box");
      const verdict = card.querySelector(".gd-verdict");
      if (actions) actions.style.display = "none";
      if (box) box.style.display = "none";
      if (verdict) { verdict.className = "gd-verdict " + cls; verdict.textContent = text; verdict.hidden = false; }
    };
    cards.forEach((card) => {
      const approve = card.querySelector(".btn.approve");
      const reject = card.querySelector(".btn.reject");
      const send = card.querySelector(".gd-send");
      if (approve && !approve.disabled) approve.addEventListener("click", () => settle(card, "ok", card.dataset.ok || "Approved."));
      if (reject) reject.addEventListener("click", () => settle(card, "no", "Declined. Nothing ran against the database."));
      if (send) send.addEventListener("click", () => settle(card, "sent", "Change request sent — the agent will revise and resubmit."));
    });
  }

  // Result view: dropdown flyouts (Copy / Export) and the pager, mirroring the plugin's controls.
  const qd = document.querySelector(".qd-card");
  if (qd) {
    const menus = Array.from(qd.querySelectorAll(".qd-menu"));
    const closeAll = (except) => menus.forEach((m) => {
      if (m === except) return;
      const b = m.querySelector(".qd-act");
      const f = m.querySelector(".qd-flyout");
      if (b) b.setAttribute("aria-expanded", "false");
      if (f) f.hidden = true;
    });
    menus.forEach((m) => {
      const btn = m.querySelector(".qd-act");
      const fly = m.querySelector(".qd-flyout");
      if (!btn || !fly) return;
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = btn.getAttribute("aria-expanded") === "true";
        closeAll(m);
        btn.setAttribute("aria-expanded", open ? "false" : "true");
        fly.hidden = open;
      });
      fly.querySelectorAll(".qd-fly-item").forEach((it) =>
        it.addEventListener("click", () => { btn.setAttribute("aria-expanded", "false"); fly.hidden = true; })
      );
    });
    document.addEventListener("click", () => closeAll(null));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAll(null); });

    const pages = Array.from(qd.querySelectorAll(".qp-pg"));
    const prev = qd.querySelector('.qp-nav[aria-label="Previous page"]');
    const next = qd.querySelector('.qp-nav[aria-label="Next page"]');
    pages.forEach((p, i) => p.addEventListener("click", () => {
      pages.forEach((q) => q.classList.remove("is-on"));
      p.classList.add("is-on");
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === pages.length - 1;
    }));
  }
</script>
