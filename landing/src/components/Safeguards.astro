<section id="safeguards" class="section-pad">
  <div class="wrap">
    <div class="sec-top">
      <div class="section-head">
        <span class="eyebrow amber">Oversight</span>
        <h2>Everything you need to <span class="h-hl"><span class="say-yes">Say Yes</span> to your agent.</span></h2>
        <p class="lead">Gatekeeper reads each proposal and annotates it: what it changes, what it touches, and what is sensitive. The dangerous parts are impossible to miss, and the risky ones cannot run unless you have armed them.</p>
      </div>
      <div class="sec-art" aria-hidden="true">
        <img src="/sections/safeguards.png" alt="" width="400" height="400" loading="lazy" decoding="async" />
      </div>
    </div>

    <div class="sg-cols">
      <!-- LEFT column: the interactive gate, then the audit trail (each column flows on its
           own, so the second block sits a fixed gap below the first and the columns stagger). -->
      <div class="sg-left">
        <h3 class="sg-title">See everything before you approve</h3>
        <div class="gate-demo" id="gate-demo">
          <div class="gd-menu" role="tablist" aria-label="Safeguards">
            <button class="gd-item is-active" type="button" role="tab" aria-selected="true" data-ex="read" data-desc="A single SELECT, enforced by a dialect-aware parser. This one runs as-is once you approve.">
              <span class="gd-item-ico ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span><span class="gd-item-title">Read-only by default</span>
            </button>
            <button class="gd-item" type="button" role="tab" aria-selected="false" data-ex="write" data-desc="INSERT and UPDATE are off by default. You arm write mode and it stays on until you disarm it, but every query still needs its own one-click approval.">
              <span class="gd-item-ico amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg></span><span class="gd-item-title">Writes must be armed</span>
            </button>
            <button class="gd-item" type="button" role="tab" aria-selected="false" data-ex="destructive" data-desc="DELETE, DROP and TRUNCATE stay locked until you arm destructive mode by typing the database name. Even then, every statement needs its own approval.">
              <span class="gd-item-ico danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg></span><span class="gd-item-title">Destructive stays locked</span>
            </button>
            <button class="gd-item" type="button" role="tab" aria-selected="false" data-ex="request" data-desc="Not just yes or no. Send the agent a note to revise, straight back over MCP.">
              <span class="gd-item-ico blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="gd-item-title">Request changes</span>
            </button>
            <button class="gd-item" type="button" role="tab" aria-selected="false" data-ex="client" data-desc="Client-confidential columns are flagged violet before you decide.">
              <span class="gd-item-ico violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg></span><span class="gd-item-title">Client data</span>
            </button>
