---
import { agents } from "./agents";
---
<div class="w works">
  <span class="k">Works with</span>
  <ul class="agents">
    {agents.map(([name, svg]) => <li><span class="mark" aria-hidden="true" set:html={svg} />{name}</li>)}
  </ul>
  <span class="more">and any other MCP client</span>
</div>

<style>
  .works { margin-top: 64px; display: grid; justify-items: center; gap: 18px; text-align: center; }
  .k { font: 500 12px / 1 var(--g-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--amber); }
  .agents { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px clamp(22px, 3vw, 40px); margin: 0; padding: 0; list-style: none; }
  .agents li { display: inline-flex; align-items: center; gap: 10px; font-size: clamp(1.05rem, 1.5vw, 1.3rem); font-weight: 500; letter-spacing: -0.02em; color: var(--text); white-space: nowrap; }
  .mark { display: inline-flex; flex: none; }
  .mark :global(svg) { width: 24px; height: 24px; }
  .mark :global(svg),
  .mark :global(svg *) { fill: var(--amber); }
  /* Kimi's mark draws its K and dot in white and blue over a square: cut them out instead. */
  .mark :global(svg [fill="#fff"]),
  .mark :global(svg [fill="#027aff"]) { fill: var(--g-ground); }
  .more { margin-top: -4px; font-size: 14.5px; font-style: italic; color: var(--muted); }
</style>
