{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "../packages/plugin/src/vite-env.d.ts",
    "../packages/plugin/src/tabulator-tables.d.ts"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    // The plugin replay swaps the SDK for src/demo/host.ts at bundle time; types still come
    // from the real package, which host.ts implements.
    "paths": {
      "@beekeeperstudio/plugin": ["../packages/plugin/node_modules/@beekeeperstudio/plugin"]
    }
  }
}
